<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>DeadfireStutterFix</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Your game folder. Override without editing: dotnet build -c Release -p:GameDir="D:\Games\Pillars of Eternity II" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pillars of Eternity II</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the modern .NET SDK build for the old .NET 3.5 that Unity 5.6 uses -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- Needs BepInEx installed in the game folder. Nothing from the game itself is referenced: the plugin finds the
         game's classes by name at runtime, so no game files are needed to build it. -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\PillarsOfEternityII_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
