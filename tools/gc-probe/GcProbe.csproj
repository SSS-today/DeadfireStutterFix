<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>GcProbe</AssemblyName>
    <!-- EDIT THIS if your game is installed somewhere else -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Pillars of Eternity II</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the modern .NET SDK build for the old .NET 3.5 that Unity 5.6 uses -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\PillarsOfEternityII_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
